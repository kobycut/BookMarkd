# Example Terraform variables file
# Copy this file to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to version control!

environment = "dev"
aws_region  = "us-east-1"

# Database configuration
db_instance_class = "db.t3.micro"  # Free tier eligible
db_username       = "bookmarkd_user"
db_password       = "your-secure-password-here"  # Minimum 8 characters

# Storage configuration
allocated_storage     = 20
max_allocated_storage = 100

# Backup configuration
backup_retention_period = 7
enable_multi_az        = false  # Set to true for production

# Network configuration (you'll need to create or reference existing resources)
vpc_id                    = "vpc-xxxxxxxxxxxxxxxxx"
private_subnet_ids        = ["subnet-xxxxxxxxxxxxxxxxx", "subnet-yyyyyyyyyyyyyyyyy"]
backend_security_group_id = "sg-xxxxxxxxxxxxxxxxx"

# Optional: Additional tags
tags = {
  Project = "BookMarkd"
  Team    = "Engineering"
}
