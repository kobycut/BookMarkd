# Example Terraform variables file
# Copy this file to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to version control!

environment = "dev"
aws_region  = "us-west-2"

# VPC Configuration
vpc_cidr            = "10.0.0.0/16" # VPC IP range
az_count            = 2 # Number of availability zones (minimum 2)
enable_nat_gateway  = true # Enable NAT for private subnet internet access
enable_vpc_endpoints = false # Enable VPC endpoints for AWS services (optional)

# Database configuration
db_instance_class = "db.t3.micro" # Free tier eligible
db_username       = "bookmarkd_user" # You pick this here
db_password       = "your-secure-password-here"  # Pick this, as long as: Minimum 8 characters

# Storage configuration
allocated_storage     = 20
max_allocated_storage = 100

# Backup configuration
backup_retention_period = 7
enable_multi_az         = false # Set to true for production high availability

# Optional: Additional tags
tags = {
  Project = "BookMarkd"
}
